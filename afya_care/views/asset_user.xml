<odoo>
    <record id="view_afyacare_asset_user_tree" model="ir.ui.view">
        <field name="name">afyacare.asset.user.tree</field>
        <field name="model">afyacare.asset.user</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_afyacare_asset_user_form" model="ir.ui.view">
        <field name="name">afyacare.asset.user.form</field>
        <field name="model">afyacare.asset.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department"/>
<!--                        <field name="active"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_afyacare_asset_user" model="ir.actions.act_window">
        <field name="name">Asset User</field>
        <field name="res_model">afyacare.asset.user</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_afyacare_asset_user_tree"/>
    </record>

    <menuitem id="menu_afyacare_asset_user" name="Asset User" parent="menu_asset_register" sequence="2" action="action_afyacare_asset_user" />
</odoo>
