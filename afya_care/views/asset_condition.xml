<odoo>
    <record id="view_afyacare_asset_condition_tree" model="ir.ui.view">
        <field name="name">afyacare.asset.condition.tree</field>
        <field name="model">afyacare.asset.condition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_afyacare_asset_condition_form" model="ir.ui.view">
        <field name="name">afyacare.asset.condition.form</field>
        <field name="model">afyacare.asset.condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
<!--                        <field name="active"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_afyacare_asset_condition" model="ir.actions.act_window">
        <field name="name">Asset Condition</field>
        <field name="res_model">afyacare.asset.condition</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_afyacare_asset_condition_tree"/>
    </record>

    <menuitem id="menu_afyacare_asset_condition" name="Asset Condition" parent="menu_asset_register" sequence="4" action="action_afyacare_asset_condition" />
</odoo>
