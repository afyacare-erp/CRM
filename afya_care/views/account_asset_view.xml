<odoo>
    <record id="view_account_asset_form_inherit" model="ir.ui.view">
        <field name="name">account.asset.form.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <field name="already_depreciated_amount_import" position="after">
                <field name="location_id"/>
                <field name="asset_tag_id"/>
                <field name="asset_condition_id"/>
                <field name="asset_user_id"/>
                <field name="serial_number_id"/>
                <field name="afy_salvage_value"/>
                <field name="afy_remaining_active_life"/>
            </field>
        </field>
    </record>

    <record id="view_account_asset_tree_inherit" model="ir.ui.view">
        <field name="name">account.asset.tree.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_purchase_tree"/>
        <field name="arch" type="xml">
            <tree>
                <field name="location_id" optional="hide"/>
                <field name="asset_tag_id" optional="hide"/>
                <field name="asset_condition_id" optional="hide"/>
                <field name="asset_user_id" optional="hide"/>
                <field name="serial_number_id" optional="hide"/>
                <field name="afy_salvage_value" optional="hide"/>
                <field name="afy_remaining_active_life" optional="hide"/>
            </tree>
        </field>
    </record>
</odoo>
