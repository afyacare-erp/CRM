<odoo>
    <record id="view_afyacare_serial_number_tree" model="ir.ui.view">
        <field name="name">afyacare.serial.number.tree</field>
        <field name="model">afyacare.serial.number</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_afyacare_serial_number_form" model="ir.ui.view">
        <field name="name">afyacare.serial.number.form</field>
        <field name="model">afyacare.serial.number</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="number"/>
<!--                        <field name="active"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_afyacare_serial_number" model="ir.actions.act_window">
        <field name="name">Serial Number</field>
        <field name="res_model">afyacare.serial.number</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_afyacare_serial_number_tree"/>
    </record>

    <menuitem id="menu_afyacare_serial_number" name="Serial Number" parent="menu_asset_register" sequence="5" action="action_afyacare_serial_number" />
</odoo>
